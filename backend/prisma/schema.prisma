// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// name  Type  @attributes

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  MULTIPLE
  BOOLEAN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum Mode {
  SOLO
  DUEL
  MULTIPLAYER
}

model Friendship {
  id        Int              @id @default(autoincrement())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  userId    Int    //send
  friendId  Int
  user      User             @relation("SentRequests",     fields: [userId],   references: [id], onDelete: Cascade)
  friend    User             @relation("ReceivedRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId]) 
  @@index([friendId])
}

model User {
  id        Int       @id @default(autoincrement())
  userName  String    @unique
  bio       String?
  email     String    @unique
  createdAt DateTime  @default(now())
  passHash  String
  avatarUrl String?
  games     GamePlayer[]
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  totalScore   Int    @default(0)
  gamesPlayed  Int    @default(0)
}

model Game {
  id         Int        @id @default(autoincrement())
  title      String
  categoryId Int // real category : which cateory 
  category   Category   @relation(fields: [categoryId], references: [id]) // quiz.category.type
  mode       Mode
  status     MatchStatus   @default(WAITING)
  difficulty  Difficulty  @default(EASY)
  questions  GameQuestion[]
  players    GamePlayer[]
  startedAt   DateTime?
  endedAt     DateTime?


  @@index([categoryId])
}

model Category {
  id          Int    @id @default(autoincrement())
  opentdbId   Int    @unique // id from opentdb to link questions
  name        String @unique
  games     Game[]
  questions   Question[]
}

model GameQuestion {
  gameId     Int
  questionId Int
  position   Int
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([gameId, questionId]) // question once per quiz
  @@unique([gameId, position]) // one question per position
}

model Question {
  id            Int      @id @default(autoincrement())
  hash          String   @unique // for the seed - not twice 
  text          String   @default("The Answer to the Ultimate Question of Life, the Universe, and Everything")
  type          QuestionType
  difficulty    Difficulty
  categoryId    Int
  category      Category    @relation(fields:[categoryId], references: [id])
  answers       Answer[]
  games         GameQuestion[]
  @@index([categoryId])
}

model Answer {
  id         Int      @id @default(autoincrement())
  text       String
  isCorrect  Boolean  @default(false)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}


model GamePlayer {
  id         Int       @id @default(autoincrement())
  score      Int       @default(0)
  joinedAt   DateTime  @default(now())
  finishedAt DateTime?
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     Int
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId]) // player joins once 
  @@index([userId])
}